# Optional: the app's Settings screen creates .env for you.
# Each student uses their own local bearer token. Never commit .env.
PURSUIT_TOKEN=your_token_here
PURSUIT_COHORT="L2 - September 2026"
PURSUIT_DAY_IDS=1648
PURSUIT_TIME_ZONE=America/New_York
PURSUIT_DASHBOARD_PORT=4782
# Publisher's canonical HTTPS GitHub repo, not the student's fork.
# If updates.json is configured in the release, leave this unset.
STUDY_UPSTREAM_URL=
